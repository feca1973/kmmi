{
  "name": "kmmi/site",
  "description": "KMMI website and admin (Symfony 7.4 LTS, PHP 8.5, EasyAdmin)",
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.5",
    "ext-ctype": "*",
    "ext-exif": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "doctrine/dbal": "^4.2",
    "doctrine/doctrine-bundle": "^3.3",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.3",
    "easycorp/easyadmin-bundle": "^5.8",
    "gedmo/doctrine-extensions": "^3.21",
    "helios-ag/fm-elfinder-bundle": "^14.0",
    "knplabs/knp-paginator-bundle": "^6.11",
    "league/html-to-markdown": "^5.2",
    "liip/imagine-bundle": "^2.18",
    "monolog/monolog": "^3.6",
    "stof/doctrine-extensions-bundle": "^1.10",
    "symfony/asset": "^7.4",
    "symfony/asset-mapper": "^7.4",
    "symfony/console": "^7.4",
    "symfony/dotenv": "^7.4",
    "symfony/flex": "^2.8",
    "symfony/form": "^7.4",
    "symfony/framework-bundle": "^7.4",
    "symfony/http-client": "^7.4",
    "symfony/property-access": "^7.4",
    "symfony/property-info": "^7.4",
    "symfony/rate-limiter": "^7.4",
    "symfony/runtime": "^7.4",
    "symfony/security-bundle": "^7.4",
    "symfony/security-csrf": "^7.4",
    "symfony/translation": "^7.4",
    "symfony/twig-bundle": "^7.4",
    "symfony/ux-twig-component": "^3.6",
    "symfony/validator": "^7.4",
    "symfony/yaml": "^7.4",
    "symfonycasts/sass-bundle": "^0.10.0",
    "twbs/bootstrap": "^5.3"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "phpmd/phpmd": "^3.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.1",
    "phpunit/phpunit": "^13.4",
    "squizlabs/php_codesniffer": "^4.0",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4",
    "symfony/maker-bundle": "^1.61",
    "symfony/phpunit-bridge": "^7.4",
    "symfony/web-profiler-bundle": "^7.4",
    "zenstruck/foundry": "^2.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true,
    "process-timeout": 0
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "elfinder:install": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd",
      "importmap:install": "symfony-cmd",
      "sass:build": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "static-code-analyze": "@qa",
    "qa:phpcs": "vendor/bin/phpcs",
    "qa:phpmd": "sh -c 'rm -rf \"${XDG_CACHE_HOME:-$HOME/.cache}/pdepend\"; vendor/bin/phpmd analyze src tests config --format text --ruleset phpmd.xml.dist'",
    "qa:phpstan": "sh -c 'if [ -d src ]; then vendor/bin/phpstan analyse src tests --memory-limit=1G; else echo \"Skip PHPStan: src directory missing.\"; fi'",
    "qa:phpunit": [
      "rm -rf var/cache/test",
      "@php bin/phpunit"
    ],
    "qa": [
      "@qa:phpcs",
      "@qa:phpmd",
      "@qa:phpstan",
      "@qa:phpunit"
    ],
    "regenerate-dev-db": [
      "@php bin/console doctrine:database:drop --if-exists --force --no-interaction",
      "@php bin/console doctrine:database:create --if-not-exists --no-interaction",
      "@php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "^7.4"
    }
  }
}
