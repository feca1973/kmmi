{% extends 'base.html.twig' %}

{% block title %}Szervezetek - {{ parent() }}{% endblock %}

{% block breadcrumb %}
    {{ include('frontend/shared/breadcrumb.html.twig', {
        crumbs: [{label: 'Kezdőlap', url: path('app_homepage')}, {label: 'Adattár'}, {label: 'Szervezetek'}],
        heading: true
    }) }}
{% endblock %}

{% block body %}
    <div class="body-content list">
        <div class="row">
            <div class="col-md-8 col-sm-12 content-col">
                <div class="content">
                    <ul class="list-unstyled">
                        {% for organization in appointments %}
                            <li>
                                <h2><a href="{{ path('organization_single', {'slug': organization.slug}) }}">{{ organization.title }}</a></h2>
                                <p class="article-update-date">Utoljára frissítve: {{ organization.updateDate|date('Y-m-d') }}</p>
                                {{ organization.fieldOfActivityId|raw }}
                            </li>
                        {% endfor %}
                    </ul>

                    <div class="navigation">
                        {{ knp_pagination_render(appointments) }}
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-12 content-col">
                <twig:SidebarNews size="4" columns="1" />
                <twig:SidebarEvents size="4" />
                <twig:SidebarGalleries size="3" />
            </div>
        </div>
    </div>
{% endblock %}
