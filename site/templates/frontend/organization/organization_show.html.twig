{% extends 'base.html.twig' %}

{% block title %}{{ organization.defaultTitle|plain_text }} | szervezetek | {{ parent() }}{% endblock %}
{% block ogTitle %}{{ organization.defaultTitle|plain_text }}{% endblock %}
{% block ogDescription %}{{ organization.fieldOfActivityId|plain_text }}{% endblock %}
{% block metaDescription %}{{ organization.fieldOfActivityId|plain_text }}{% endblock %}

{% block breadcrumb %}
    {{ include('frontend/shared/breadcrumb.html.twig', {
        crumbs: [
            {label: 'Kezdőlap', url: path('app_homepage')},
            {label: 'Adattár'},
            {label: 'Szervezetek', url: path('organization_list')},
            {label: organization.defaultTitle}
        ]
    }) }}
{% endblock %}

{% block body %}
    <div class="body-content list">
        <div class="row">
            <div class="col-md-12 col-sm-12 content-col">
                <div class="content article-title">
                    <h1>{{ organization.defaultTitle }}</h1>
                    <p class="article-update-date">Utoljára frissítve: {{ organization.updateDate|date('Y-m-d') }}</p>
                </div>
            </div>
            <div class="col-md-8 col-sm-12 content-col">
                <div class="content">
                    {{ include('frontend/shared/share.html.twig', {title: organization.defaultTitle}) }}

                    {{ include('frontend/organization/block.html.twig', {block: organization.fieldOfActivityId, title: 'Működési területe'}) }}
                    {{ include('frontend/organization/block.html.twig', {block: organization.goal, title: 'Szervezet célja'}) }}
                    {{ include('frontend/organization/block.html.twig', {block: organization.services, title: 'Szolgáltatások'}) }}

                    <div class="single-page-block-title">Bemutatás</div>
                    <div class="article-content">
                        {% if organization.introduction %}
                            {{ include('frontend/organization/floating_box.html.twig', {class: 'half-page'}) }}
                            {{ organization.introduction|raw }}
                        {% else %}
                            {{ include('frontend/organization/floating_box.html.twig', {class: 'full-page'}) }}
                        {% endif %}
                        <div class="clearfix"></div>
                    </div>

                    {{ include('frontend/organization/block.html.twig', {block: organization.officialPersonShortCv, title: 'Vezető bemutatása'}) }}

                    {{ include('frontend/media/gallery.html.twig', {entity: organization}) }}

                    {{ include('frontend/media/attachment.html.twig', {entity: organization}) }}
                </div>
            </div>
            <div class="col-md-4 col-sm-12 content-col">
                <twig:SidebarNews size="4" columns="1" />
                <twig:SidebarEvents size="3" />
                <twig:SidebarGalleries size="2" />
            </div>
        </div>
    </div>
{% endblock %}
