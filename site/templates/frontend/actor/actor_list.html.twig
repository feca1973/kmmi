{% extends 'base.html.twig' %}

{% block title %}{{ type.name|plain_text }} - {{ parent() }}{% endblock %}
{% block ogTitle %}{{ type.name|plain_text }} - {{ uniqueContent('page-title') }}{% endblock %}

{% block breadcrumb %}
    {{ include('frontend/shared/breadcrumb.html.twig', {
        crumbs: [{label: 'Kezdőlap', url: path('app_homepage')}, {label: 'Adattár'}, {label: type.name}],
        heading: true
    }) }}
{% endblock %}

{% block body %}
    <div class="body-content list">
        <div class="row">
            <div class="col-md-8 col-sm-12 content-col">
                <div class="content">
                    <ul class="list-unstyled">
                        {% for article in appointments %}
                            <li>
                                <h2><a href="{{ path('actor_show', {'category': type.slug, 'slug': article.slug}) }}">{{ article.title|raw }}</a></h2>
                                {% if article.city is not null %}
                                    <p class="article-update-date">Kapcsolódó település: <a href="{{ path('cities_single', {'region': article.city.regions.slug, 'slug': article.city.slug}) }}">{{ article.city.defaultTitle }}</a></p>
                                {% endif %}
                                {{ article.lead|raw }}
                                <div class="clear"></div>
                            </li>
                        {% endfor %}
                    </ul>

                    <div class="navigation">
                        {{ knp_pagination_render(appointments) }}
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-12 content-col">
                <twig:SidebarNews size="3" columns="1" />
                <twig:SidebarEvents size="6" />
                <twig:SidebarGalleries size="3" />
            </div>
        </div>
    </div>
{% endblock %}
