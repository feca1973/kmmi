{% extends 'base.html.twig' %}

{% block title %}{{ media.title|plain_text }} - {{ typeTitle }} - Multimédia - {{ parent() }}{% endblock %}
{% block ogTitle %}{{ media.title|plain_text }} - {{ typeTitle }} - Multimédia - {{ uniqueContent('page-title') }}{% endblock %}
{% block ogDescription %}{{ media.lead|plain_text }}{% endblock %}
{% block metaDescription %}{{ media.lead|plain_text }}{% endblock %}

{% block breadcrumb %}
    {{ include('frontend/shared/breadcrumb.html.twig', {
        crumbs: [
            {label: 'Kezdőlap', url: path('app_homepage')},
            {label: 'Adattár'},
            {label: 'Multimédia'},
            {label: typeTitle, url: path(media.type.value ~ '_list')},
            {label: media.title}
        ],
        title: true
    }) }}
{% endblock %}

{% block body %}
    <div class="body-content list">
        <div class="row">
            <div class="col-md-12 col-sm-12 content-col">
                <div class="content article-title">
                    <h1>{{ media.title|raw }}</h1>
                </div>
            </div>
            <div class="col-md-8 col-sm-12 content-col">
                <div class="content">
                    {{ include('frontend/shared/share.html.twig', {title: media.title}) }}

                    <div class="article-content">
                        {{ media.lead|raw }}
                    </div>

                    <div class="article-content">
                        {{ include('frontend/media/' ~ media.type.value ~ '_player.html.twig', {path: media.path}) }}
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-12 content-col">
                <twig:SidebarNews size="4" columns="1" />
            </div>
        </div>
    </div>
{% endblock %}
