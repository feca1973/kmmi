{% extends 'base.html.twig' %}

{% block title %}{{ type.name|plain_text }} | könyvtár | adattár | {{ parent() }}{% endblock %}
{% block ogTitle %}{{ type.name|plain_text }} | könyvtár | adattár | {{ uniqueContent('page-title') }}{% endblock %}

{% block breadcrumb %}
    {{ include('frontend/shared/breadcrumb.html.twig', {
        crumbs: [{label: 'Kezdőlap', url: path('app_homepage')}, {label: 'Adattár'}, {label: 'Könyvtár'}]
            |merge(type.parent ? [{label: type.parent.name}] : [])
            |merge([{label: type.name}]),
        heading: true
    }) }}
{% endblock %}

{% block body %}
    <div class="body-content list">
        <div class="row">
            <div class="col-md-8 col-sm-12 content-col">
                <div class="content">
                    <ul class="list-unstyled">
                        {% if appointments|length == 0 %}
                            <li>
                                <h2>Nincs megjeleníthető tartalom</h2>
                            </li>
                        {% endif %}
                        {% for article in appointments %}
                            <li>
                                <h2>
                                    <a href="{{ path('library_show', {'category': type.slug, 'slug': article.slug}) }}">{{ article.title|raw }}</a>
                                </h2>
                                <p class="article-update-date">Írta: {{ article.bookAuthor }} | A kiadás éve: {{ article.bookReleaseYear }}</p>
                                {{ article.lead|raw }}
                            </li>
                        {% endfor %}
                    </ul>

                    <div class="navigation">
                        {{ knp_pagination_render(appointments) }}
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-12 content-col">
                <twig:SidebarEvents size="6" />
                <twig:SidebarGalleries size="3" />
            </div>
        </div>
    </div>
{% endblock %}
