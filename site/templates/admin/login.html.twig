<!doctype html>
<html lang="hu">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Admin Login</title>
    {{ importmap('admin-login') }}
</head>
<body>
<div id="admin-login">
    <form class="login" method="post" action="{{ path('admin_login_check') }}">
        <fieldset>
            <legend class="legend">Login</legend>
            <div class="input">
                <input type="text" name="_username" placeholder="Email" autocomplete="username" required>
                <span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
            </div>
            <div class="input">
                <input type="password" name="_password" placeholder="Password" autocomplete="current-password" required>
                <span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>
            </div>
            <div class="input" style="color: black">
                <label><input type="checkbox" name="_remember_me" value="on">Jegyezz meg</label>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="submit"><svg viewBox="0 0 24 24" aria-hidden="true" class="filled"><path d="M8 5v14l11-7z"/></svg></button>
        </fieldset>
        <div class="feedback">
            sikertelen belépés
        </div>
    </form>
</div>
</body>
</html>
