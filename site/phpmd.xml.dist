<?xml version="1.0"?>
<ruleset name="KMMI"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>KMMI mess detector rules</description>

    <rule ref="rulesets/cleancode.xml">
        <exclude name="StaticAccess"/>
        <exclude name="BooleanArgumentFlag"/>
    </rule>
    <rule ref="rulesets/cleancode.xml/StaticAccess">
        <properties>
            <!-- EasyAdmin is configured through static factories (MenuItem::linkTo(), TextField::new() ...).
                 Add a field class here when a CRUD starts using it. A request is made by its static factory too
                 (Request::create()). -->
            <property name="exceptions" value="\Symfony\Component\HttpFoundation\Request,\App\Enum\MediaType,\App\Controller\Admin\Field\TranslationField,\App\Controller\Admin\Field\RichTextField,\App\Controller\Admin\Field\FileChooserField,\EasyCorp\Bundle\EasyAdminBundle\Field\CollectionField,\Symfony\Component\HttpClient\HttpClient,\EasyCorp\Bundle\EasyAdminBundle\Filter\EntityFilter,\EasyCorp\Bundle\EasyAdminBundle\Config\MenuItem,\EasyCorp\Bundle\EasyAdminBundle\Config\Dashboard,\EasyCorp\Bundle\EasyAdminBundle\Config\Crud,\EasyCorp\Bundle\EasyAdminBundle\Config\Assets,\EasyCorp\Bundle\EasyAdminBundle\Config\Actions,\EasyCorp\Bundle\EasyAdminBundle\Config\Action,\EasyCorp\Bundle\EasyAdminBundle\Config\Filters,\EasyCorp\Bundle\EasyAdminBundle\Config\KeyValueStore,\EasyCorp\Bundle\EasyAdminBundle\Field\TextField,\EasyCorp\Bundle\EasyAdminBundle\Field\EmailField,\EasyCorp\Bundle\EasyAdminBundle\Field\BooleanField,\EasyCorp\Bundle\EasyAdminBundle\Field\ChoiceField,\EasyCorp\Bundle\EasyAdminBundle\Field\IdField,\EasyCorp\Bundle\EasyAdminBundle\Field\ImageField,\EasyCorp\Bundle\EasyAdminBundle\Field\TextareaField,\EasyCorp\Bundle\EasyAdminBundle\Field\TextEditorField,\EasyCorp\Bundle\EasyAdminBundle\Field\AssociationField,\EasyCorp\Bundle\EasyAdminBundle\Field\DateField,\EasyCorp\Bundle\EasyAdminBundle\Field\DateTimeField,\EasyCorp\Bundle\EasyAdminBundle\Field\IntegerField,\EasyCorp\Bundle\EasyAdminBundle\Field\NumberField,\EasyCorp\Bundle\EasyAdminBundle\Field\ArrayField,\EasyCorp\Bundle\EasyAdminBundle\Field\UrlField,\EasyCorp\Bundle\EasyAdminBundle\Field\SlugField,\EasyCorp\Bundle\EasyAdminBundle\Field\CollectionField,\EasyCorp\Bundle\EasyAdminBundle\Field\FormField,\EasyCorp\Bundle\EasyAdminBundle\Field\HiddenField,\EasyCorp\Bundle\EasyAdminBundle\Field\TelephoneField,\EasyCorp\Bundle\EasyAdminBundle\Field\ColorField"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml"/>
    <rule ref="rulesets/controversial.xml"/>
    <rule ref="rulesets/design.xml"/>
    <rule ref="rulesets/naming.xml">
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
        <exclude name="LongMethodName"/>
    </rule>
    <rule ref="rulesets/naming.xml/LongMethodName">
        <properties>
            <!-- Descriptive test method names are more important than short ones. -->
            <property name="maximum" value="60"/>
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <!-- `$id` is the usual identifier name of entities. -->
            <property name="exceptions" value="id"/>
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/LongVariable">
        <properties>
            <!-- Legacy column names like officialPersonTelephoneOffice. -->
            <property name="maximum" value="32"/>
        </properties>
    </rule>
    <rule ref="rulesets/unusedcode.xml"/>

    <!-- Generated by Symfony Flex / the framework; not our code. -->
    <exclude-pattern>config/reference.php</exclude-pattern>
    <exclude-pattern>config/preload.php</exclude-pattern>
    <exclude-pattern>migrations/*</exclude-pattern>
</ruleset>
