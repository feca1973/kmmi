# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# Real values (APP_SECRET, DATABASE_URL, CKEditor license key) live in .env.local:
# scripts/project-init.sh creates it for dev, on production it is created by hand (see README.md).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Placeholder only, the real value is in .env.local.
DATABASE_URL="mysql://app:change-me@127.0.0.1:3306/app?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> ckeditor ###
# The CKEditor 5 license key (dev key in .env.local on dev, production key on the production server).
CKEDITOR_LICENSE_KEY=
###< ckeditor ###

###> seo ###
# 1: the robots.txt lets the crawlers in (production); 0: it closes the whole site (dev, staging).
SEO_INDEXING_ENABLED=1
###< seo ###
