# Docker Compose variables for the local dev environment.
# scripts/project-init.sh copies this file to ../.env and fills the passwords.
# Do not put real secrets in this file; ../.env is not committed.

PROJECT_NAME=kmmi
TZ=Europe/Budapest

HTTP_PORT=8081
PHPMYADMIN_PORT=8082
MYSQL_PORT=3308

MYSQL_ROOT_PASSWORD=__GENERATE__
MYSQL_DATABASE=kmmi
MYSQL_USER=kmmi
MYSQL_PASSWORD=__GENERATE__

PHPMYADMIN_UPLOAD_LIMIT=50M
